From beac57f652b8c700635421ba61acfd217e17e8ae Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Sat, 5 Sep 2026 00:54:56 -0700
Subject: [PATCH] Allow no-disc selection with eight playlist slots

The array bound check rejected index == count when all eight slots
were used, leaving the previous disc selected. Accept the count sentinel
before looking up a slot.

Reproduced with real CHDs, then verified no-disc save/load with both tray
states and selection after removing every image.
---
 frontend/libretro.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/frontend/libretro.c b/frontend/libretro.c
index 4b72911a..019accfb 100644
--- a/frontend/libretro.c
+++ b/frontend/libretro.c
@@ -1515,13 +1515,13 @@ static unsigned int disk_get_image_index(void)
 
 static bool disk_set_image_index(unsigned int index)
 {
-   if (index >= sizeof(disks) / sizeof(disks[0]))
+   if (index > disk_count)
       return false;
 
    CdromId[0] = '\0';
    CdromLabel[0] = '\0';
 
-   if (disks[index].fname == NULL)
+   if (index == disk_count || disks[index].fname == NULL)
    {
       LogErr("missing disk #%u\n", index);
       cdra_shutdown();
-- 
