From a57d96d7b3780ef44fc0bcc67333365d1efde159 Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Sat, 5 Sep 2026 00:51:06 -0700
Subject: [PATCH] Support absolute disc paths in M3U playlists

An absolute MGS disc path was prefixed with the playlist directory,
so loading the playlist failed. Keep absolute paths as written and
resolve relative entries against the playlist directory.

Tested real CHDs with absolute, relative, and mixed playlists, including
comments, blank lines, CRLF, and a final line without a newline.
---
 frontend/libretro.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/frontend/libretro.c b/frontend/libretro.c
index 4b72911a..590acc5e 100644
--- a/frontend/libretro.c
+++ b/frontend/libretro.c
@@ -1720,7 +1720,11 @@ static bool read_m3u(const char *file)
          char disk_label[PATH_MAX];
          disk_label[0] = '\0';
 
-         snprintf(name, sizeof(name), "%s%c%s", base_dir, SLASH, line);
+         if (line[0] == '/' || line[0] == '\\' ||
+             (line[1] == ':' && (line[2] == '/' || line[2] == '\\')))
+            snprintf(name, sizeof(name), "%s", line);
+         else
+            snprintf(name, sizeof(name), "%s%c%s", base_dir, SLASH, line);
          disks[disk_count].fname = strdup(name);
 
          get_disk_label(disk_label, name, PATH_MAX);
