msgstr ""

msgctxt "#30211"
msgid "Compatibility Fixes"
msgstr ""

msgctxt "#30212"
msgid "Configure settings/workarounds required for correct operation of specific games."
msgstr ""

msgctxt "#30213"
msgid "Enable emulation of the PSX CPU instruction cache. Improves accuracy at the expense of increased performance overheads. Required for Formula One 2001, Formula One Arcade and Formula One 99. [Interpreter only; partial on lightrec and ARM dynarecs]"
msgstr ""

msgctxt "#30214"
msgid "Enable emulation of some almost never used PSX's debug features. This causes a performance hit, is not useful for games and is intended for PSX homebrew and romhack developers only. Only enable if you know what you are doing. [Interpreter only]"
